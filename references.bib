@article{woo2023,
	title = {{ICTV} {Virus} {Taxonomy} {Profile}: {Coronaviridae} 2023},
	volume = {104},
	issn = {1465-2099},
	shorttitle = {{ICTV} {Virus} {Taxonomy} {Profile}},
	url = {https://www.microbiologyresearch.org/content/journal/jgv/10.1099/jgv.0.001843},
	doi = {10.1099/jgv.0.001843},
	abstract = {The family Coronaviridae includes viruses with positive-sense RNA genomes of 22–36 kb that are expressed through a nested set of 3′ co-terminal subgenomic mRNAs. Members of the subfamily Orthocoronavirinae are characterized by 80–160 nm diameter, enveloped virions with spike projections. The orthocoronaviruses, severe acute respiratory syndrome coronavirus and Middle East respiratory syndrome-related coronavirus are extremely pathogenic for humans and in the last two decades have been responsible for the SARS and MERS epidemics. Another orthocoronavirus, severe acute respiratory syndrome coronavirus 2, was responsible for the recent global COVID-19 pandemic. This is a summary of the International Committee on Taxonomy of Viruses (ICTV) Report on the family Coronaviridae which is available at www.ictv.global/report/coronaviridae.},
	number = {4},
	urldate = {2025-09-29},
