@article{meng2022,
	title = {{SARS}-{CoV}-2 spike {N}-terminal domain modulates {TMPRSS2}-dependent viral entry and fusogenicity},
	volume = {40},
	issn = {2211-1247},
	url = {https://www.sciencedirect.com/science/article/pii/S2211124722010373},
	doi = {10.1016/j.celrep.2022.111220},
	abstract = {The severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) spike N-terminal domain (NTD) remains poorly characterized despite enrichment of mutations in this region across variants of concern (VOCs). Here, we examine the contribution of the NTD to infection and cell-cell fusion by constructing chimeric spikes bearing B.1.617 lineage (Delta and Kappa variants) NTDs and generating spike pseudotyped lentivirus. We find that the Delta NTD on a Kappa or wild-type (WT) background increases S1/S2 cleavage efficiency and virus entry, specifically in lung cells and airway organoids, through use of TMPRSS2. Delta exhibits increased cell-cell fusogenicity that could be conferred to WT and Kappa spikes by Delta NTD transfer. However, chimeras of Omicron BA.1 and BA.2 spikes with a Delta NTD do not show more efficient TMPRSS2 use or fusogenicity. We conclude that the NTD allosterically modulates S1/S2 cleavage and spike-mediated functions in a spike context-dependent manner, and allosteric interactions may be lost when combining regions from more distantly related VOCs.},
	number = {7},
	urldate = {2025-09-30},
	journal = {Cell Reports},
	author = {Meng, Bo and Datir, Rawlings and Choi, Jinwook and Baker, Stephen and Dougan, Gordon and Hess, Christoph and Kingston, Nathalie and Lehner, Paul J. and Lyons, Paul A. and Matheson, Nicholas J. and Owehand, Willem H. and Saunders, Caroline and Summers, Charlotte and Thaventhiran, James E. D. and Toshner, Mark and Weekes, Michael P. and Maxwell, Patrick and Shaw, Ashley and Bucke, Ashlea and Calder, Jo and Canna, Laura and Domingo, Jason and Elmer, Anne and Fuller, Stewart and Harris, Julie and Hewitt, Sarah and Kennet, Jane and Jose, Sherly and Kourampa, Jenny and Meadows, Anne and O’Brien, Criona and Price, Jane and Publico, Cherry and Rastall, Rebecca and Ribeiro, Carla and Rowlands, Jane and Ruffolo, Valentina and Tordesillas, Hugo and Bullman, Ben and Dunmore, Benjamin J. and Fawke, Stuart and Gräf, Stefan and Hodgson, Josh and Huang, Christopher and Hunter, Kelvin and Jones, Emma and Legchenko, Ekaterina and Matara, Cecilia and Martin, Jennifer and Mescia, Federica and O’Donnell, Ciara and Pointon, Linda and Shih, Joy and Sutcliffe, Rachel and Tilly, Tobias and Treacy, Carmen and Tong, Zhen and Wood, Jennifer and Wylot, Marta and Betancourt, Ariana and Bower, Georgie and Cossetti, Chiara and De Sa, Aloka and Epping, Madeline and Fawke, Stuart and Gleadall, Nick and Grenfell, Richard and Hinch, Andrew and Jackson, Sarah and Jarvis, Isobel and Krishna, Ben and Nice, Francesca and Omarjee, Ommar and Perera, Marianne and Potts, Martin and Richoz, Nathan and Romashova, Veronika and Stefanucci, Luca and Strezlecki, Mateusz and Turner, Lori and De Bie, Eckart M. D. D. and Bunclark, Katherine and Josipovic, Masa and Mackay, Michael and Allison, John and Butcher, Helen and Caputo, Daniela and Clapham-Riley, Debbie and Dewhurst, Eleanor and Furlong, Anita and Graves, Barbara and Gray, Jennifer and Ivers, Tasmin and Le Gresley, Emma and Linger, Rachel and Meloy, Sarah and Muldoon, Francesca and Ovington, Nigel and Papadia, Sofia and Phelan, Isabel and Stark, Han